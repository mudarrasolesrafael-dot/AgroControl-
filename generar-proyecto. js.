  const unread=notifs.filter(n=>!n.is_read).length;
  if(loading)return<div className="space-y-3">{Array(5).fill(0).map((_,i)=><div key={i} className="h-20 bg-gray-200 animate-pulse rounded-xl"/>)}</div>;
  return<div className="space-y-6"><div className="flex justify-between"><div><h1 className="text-2xl font-bold">Notificaciones</h1><p className="text-gray-500">{unread} sin leer</p></div><Bell className="w-8 h-8 text-gray-400"/></div>{notifs.length===0?<Card className="text-center py-12 text-gray-500"><Bell className="w-12 h-12 mx-auto mb-3 text-gray-300"/><p>No hay notificaciones</p></Card>:<div className="space-y-3">{notifs.map(n=><Card key={n.id} className={\`flex items-start gap-4 \${!n.is_read?'bg-blue-50/50 border-blue-100':''}\`}><div className="w-10 h-10 rounded-xl bg-gray-100 flex items-center justify-center flex-shrink-0">{icons[n.type]||icons.default}</div><div className="flex-1"><div className="flex justify-between"><div><p className="font-semibold">{n.title}</p><p className="text-sm text-gray-600">{n.message}</p></div>{!n.is_read&&<button onClick={()=>mark(n.id)} className="p-1.5 bg-white rounded-lg shadow-sm border"><Check className="w-4 h-4 text-brand-600"/></button>}</div><p className="text-xs text-gray-400 mt-2">{formatDateTime(n.created_at)}</p></div></Card>)}</div>}</div>;
};`);

