export const calculateDistance = (lat1: number, lon1: number, lat2: number, lon2: number): number => { const R = 6371000; const dLat = (lat2 - lat1) * Math.PI / 180; const dLon = (lon2 - lon1) * Math.PI / 180; const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLon/2)**2; return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a)); };
export const isWithinRadius = (lat1: number, lon1: number, lat2: number, lon2: number, radius: number): { distance: number; within: boolean } => { const d = calculateDistance(lat1, lon1, lat2, lon2); return { distance: Math.round(d*100)/100, within: d <= radius }; };
